// Citizen parameters (GAME_DESIGN §10, ALGORITHMS §16).
(
    // Household size 1–5.
    household_size_weights: (0.28, 0.34, 0.16, 0.15, 0.07),
    // Education of arriving adults: none, secondary, higher (until schools exist, M6).
    adult_education_weights: (0.45, 0.38, 0.17),
    // Probability that the second member of a household of ≥ 2 is an adult (else a child).
    second_adult_p: 0.75,
    // Probability that a household of ≤ 2 adults is retired.
    senior_household_p: 0.12,
    // Wealth by home level (index = level − 1): weights of Low, Mid, High.
    wealth_by_level: ((0.55, 0.40, 0.05), (0.40, 0.48, 0.12), (0.30, 0.50, 0.20), (0.25, 0.50, 0.25), (0.20, 0.45, 0.35)),
    // Cars per household by wealth (stochastic rounding).
    cars_by_wealth: (0.6, 1.0, 1.5),
    // Immigration per game hour: ceil(max(R, 0) × base × (1 + pop / pop_scale)).
    immigration_base_per_game_h: 6.0,
    immigration_pop_scale: 1500.0,
    // Macro commute model (ALGORITHMS §16, ADR-0062).
    commute: (
        // Job matching rejects routed estimates above this (sim s; 300 sim s = 30 perceived min).
        max_sim_s: 300.0,
        // Door to road and parking, per trip end (sim s).
        terminal_sim_s: 10.0,
        // Shift starts in game minutes after midnight: N(mean, sd) truncated to range; a share
        // works the alternative shift starting alt_offset later (evening / night).
        commercial: (mean_min: 525.0, sd_min: 75.0, range_min: (390.0, 690.0), alt_share: 0.15, alt_offset_min: 480.0),
        industrial: (mean_min: 450.0, sd_min: 45.0, range_min: (360.0, 660.0), alt_share: 0.10, alt_offset_min: 960.0),
        // Departure = shift start − commute (game min) − slack N(mean, sd).
        slack_min: (10.0, 5.0),
        // Perceived commute minutes scoring 1 and 0 in happiness.
        score_min: (10.0, 60.0),
        // Citizen trips per vehicle-trip entity; link volumes count entities like agents do.
        trip_scale: 6.0,
        // Share of a day's commuters in the peak game hour (BPR day costs use the peak).
        peak_hour_share: 0.3,
    ),
)
